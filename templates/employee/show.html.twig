{% extends 'base.html.twig' %}

{% block title %}{{ employee.firstName }} {{ employee.lastName }} — Profile{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="{{ path('app_employee_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
            <div class="d-flex gap-2">
                <a href="{{ path('app_employee_edit', {'id': employee.id}) }}" class="btn btn-warning">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a>
                <form method="post" action="{{ path('app_employee_delete', {'id': employee.id}) }}"
                      onsubmit="return confirm('Are you sure you want to delete this employee?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
                    <button class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header py-4">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,0.2);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:22px;">
                        {{ employee.firstName|first|upper }}{{ employee.lastName|first|upper }}
                    </div>
                    <div>
                        <h4 class="mb-1 text-white">
                            {{ employee.firstName }} {{ employee.lastName }}
                        </h4>
                        <span class="badge bg-light text-dark">
                            <i class="bi bi-building me-1"></i>{{ employee.department }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-hash me-1"></i>Employee ID
                            </div>
                            <div class="fw-semibold">#{{ employee.id }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-envelope me-1"></i>Email
                            </div>
                            <div class="fw-semibold">{{ employee.email }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-building me-1"></i>Department
                            </div>
                            <div class="fw-semibold">
                                <span class="badge-department">{{ employee.department }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-currency-dollar me-1"></i>Salary
                            </div>
                            <div class="fw-semibold text-success fs-5">
                                ${{ employee.salary|number_format(2) }}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-calendar3 me-1"></i>Joined At
                            </div>
                            <div class="fw-semibold">
                                {{ employee.joinedAt ? employee.joinedAt|date('F d, Y') : '-' }}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-clock me-1"></i>Join Time
                            </div>
                            <div class="fw-semibold">
                                {{ employee.joinedAt ? employee.joinedAt|date('h:i A') : '-' }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}