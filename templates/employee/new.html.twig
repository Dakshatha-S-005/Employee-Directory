{% extends 'base.html.twig' %}

{% block title %}Add New Employee{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card mt-4">
            <div class="card-header py-3">
                <h4 class="mb-0">
                    <i class="bi bi-person-plus-fill me-2"></i>Add New Employee
                </h4>
            </div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person me-1"></i>First Name
                    </label>
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person me-1"></i>Last Name
                    </label>
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-envelope me-1"></i>Email
                    </label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email address'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-building me-1"></i>Department
                    </label>
                    {{ form_widget(form.department, {'attr': {'class': 'form-control', 'placeholder': 'Enter department'}}) }}
                    {{ form_errors(form.department) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-currency-dollar me-1"></i>Salary
                    </label>
                    {{ form_widget(form.salary, {'attr': {'class': 'form-control', 'placeholder': 'Enter salary amount'}}) }}
                    {{ form_errors(form.salary) }}
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar me-1"></i>Joined At
                    </label>
                    <div class="input-group">
                        {{ form_widget(form.joinedAt, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    {{ form_errors(form.joinedAt) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-2"></i>Save Employee
                    </button>
                    <a href="{{ path('app_employee_index') }}" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}