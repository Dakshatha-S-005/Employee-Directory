{% extends 'base.html.twig' %}  

{% block title %}Employee Directory{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people-fill me-2"></i>Employee Directory
        </h2>
        <p class="text-muted mb-0">Manage all your employees in one place</p>
    </div>
    <a href="{{ path('app_employee_new') }}" class="btn btn-primary px-4">
        <i class="bi bi-person-plus-fill me-2"></i>Add Employee
    </a>
</div>

<div class="card">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white">
            <i class="bi bi-table me-2"></i>All Employees
        </h5>
        <span class="badge bg-light text-dark">
            {{ employees|length }} total
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Salary</th>
                        <th>Joined At</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for employee in employees %}
                    <tr>
                        <td class="ps-4 text-muted">{{ employee.id }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#1a1a2e,#16213e);color:white;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:14px;flex-shrink:0;">
                                    {{ employee.firstName|first|upper }}{{ employee.lastName|first|upper }}
                                </div>
                                <div>
                                    <div class="fw-semibold">{{ employee.firstName }} {{ employee.lastName }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <i class="bi bi-envelope me-1 text-muted"></i>{{ employee.email }}
                        </td>
                        <td>
                            <span class="badge-department">
                                {{ employee.department }}
                            </span>
                        </td>
                        <td>
                            <span class="fw-semibold text-success">
                                ${{ employee.salary|number_format(2) }}
                            </span>
                        </td>
                        <td>
                            <i class="bi bi-calendar3 me-1 text-muted"></i>
                            {{ employee.joinedAt ? employee.joinedAt|date('M d, Y') : '-' }}
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="{{ path('app_employee_show', {'id': employee.id}) }}"
                                   class="btn btn-sm btn-outline-primary" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_employee_edit', {'id': employee.id}) }}"
                                   class="btn btn-sm btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_employee_delete', {'id': employee.id}) }}"
                                      onsubmit="return confirm('Are you sure you want to delete this employee?');"
                                      style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="bi bi-inbox display-4 text-muted d-block mb-3"></i>
                            <h5 class="text-muted">No employees found</h5>
                            <a href="{{ path('app_employee_new') }}" class="btn btn-primary mt-2">
                                <i class="bi bi-person-plus me-2"></i>Add First Employee
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}