{% extends 'base.html.twig' %}

{% block title %}Edit Employee — {{ employee.firstName }} {{ employee.lastName }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="{{ path('app_employee_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
            <form method="post" action="{{ path('app_employee_delete', {'id': employee.id}) }}"
                  onsubmit="return confirm('Are you sure you want to delete this employee?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
                <button class="btn btn-outline-danger">
                    <i class="bi bi-trash me-2"></i>Delete Employee
                </button>
            </form>
        </div>

        <div class="card">
            <div class="card-header py-3">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:45px;height:45px;border-radius:50%;background:rgba(255,255,255,0.2);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;">
                        {{ employee.firstName|first|upper }}{{ employee.lastName|first|upper }}
                    </div>
                    <div>
                        <h5 class="mb-0 text-white">
                            <i class="bi bi-pencil-square me-2"></i>Edit Employee
                        </h5>
                        <small style="color:rgba(255,255,255,0.7)">
                            {{ employee.firstName }} {{ employee.lastName }}
                        </small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person me-1"></i>First Name
                    </label>
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-person me-1"></i>Last Name
                    </label>
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-envelope me-1"></i>Email
                    </label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email address'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-building me-1"></i>Department
                    </label>
                    {{ form_widget(form.department, {'attr': {'class': 'form-control', 'placeholder': 'Enter department'}}) }}
                    {{ form_errors(form.department) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-currency-dollar me-1"></i>Salary
                    </label>
                    {{ form_widget(form.salary, {'attr': {'class': 'form-control', 'placeholder': 'Enter salary amount'}}) }}
                    {{ form_errors(form.salary) }}
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar me-1"></i>Joined At
                    </label>
                    {{ form_widget(form.joinedAt, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.joinedAt) }}
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-check-circle me-2"></i>Update Employee
                    </button>
                    <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-eye me-2"></i>View Profile
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}